# Supabase project settings — Project Settings > API in the Supabase dashboard.
# NEXT_PUBLIC_ vars are bundled into the browser; this is expected and safe for
# the anon key (access is governed by the RLS policies in supabase/schema.sql).
# Never put the service-role key here or anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
